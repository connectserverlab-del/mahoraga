# Copy to .env and fill in at least one LLM API key.

# --- LLM keys (first one found wins unless MAHORAGA_LLM_PROVIDER is set) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
BROWSER_USE_API_KEY=
GROQ_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# --- Mahoraga settings (all optional) ---
# MAHORAGA_LLM_PROVIDER=anthropic   # anthropic | openai | google | browser-use | groq | ollama
# MAHORAGA_MODEL=claude-sonnet-5
# MAHORAGA_HEADLESS=true
# MAHORAGA_MAX_STEPS=50
# MAHORAGA_USE_VISION=true
# MAHORAGA_CHROMIUM_PATH=/usr/bin/chromium

# --- BrowserOS kernel (optional) ---
# When set, Mahoraga attaches to this running BrowserOS/Chromium over CDP
# instead of launching its own browser.
# BROWSEROS_CDP_URL=http://localhost:9222

# --- HTTP service (optional) ---
# If set, the service requires this key in the X-API-Key header.
# MAHORAGA_API_KEY=
